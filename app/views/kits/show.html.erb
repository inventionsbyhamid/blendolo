<% label, path = next_step_for(@kit) %>
<div class="page stack">
  <header class="stack">
    <% if @kit.example? %>
      <% person = Examples.fetch(@kit.example_key) %>
      <%= render "components/honest_label", text: "Example person. #{Examples.photo_label}" %>
      <h1 class="m-0"><%= person.name %>'s kit</h1>
      <p class="lead m-0"><%= person.blurb %></p>
    <% else %>
      <h1 class="m-0">Your kit</h1>
    <% end %>
  </header>

  <%= render "components/button", label: label, href: path, variant: :primary, icon: :next %>

  <section class="card stack" aria-labelledby="progress-title">
    <h2 id="progress-title" class="m-0">So far</h2>
    <ul class="setup-list">
      <li class="<%= @kit.consented_at? ? "done" : "todo" %>">Before we start</li>
      <li class="<%= Kit::HAND_QUESTIONS.all? { |question| !@kit.public_send(question).nil? } ? "done" : "todo" %>">Your hands</li>
      <li class="<%= @kit.photos.today.exists? ? "done" : "todo" %>">Your photo</li>
      <li class="<%= RoutinePlan.entries(@kit).present? ? "done" : "todo" %>">Your routine</li>
    </ul>
  </section>

  <% if RoutinePlan.entries(@kit).present? %>
    <div class="button-row button-row--2">
      <%= render "components/button", label: "Step cards", href: kit_routine_path(@kit), variant: :secondary %>
      <%= render "components/button", label: "Shopping list", href: kit_shopping_path(@kit), variant: :secondary %>
    </div>
  <% end %>
  <div class="button-row button-row--2">
    <%= render "components/button", label: "Looks", href: kit_looks_path(@kit), variant: :secondary %>
    <% if @kit.example? %>
      <%= render "components/button", label: "Start your own kit", href: start_path, variant: :secondary %>
    <% else %>
      <%= render "components/button", label: "Share with a helper", href: kit_shares_path(@kit), variant: :secondary, icon: :share %>
    <% end %>
  </div>
  <%= render "kits/signature_entry", kit: @kit %>

  <%= render "kits/hands_today", kit: @kit %>

  <% unless @kit.example? %>
    <section class="stack" aria-labelledby="link-title" data-controller="copy">
      <h2 id="link-title" class="m-0">Your private link</h2>
      <p class="m-0">Everything is saved. Come back any time with this link. Anyone with it can open your kit.</p>
      <label class="sr-only" for="kit-link">Your private link</label>
      <input id="kit-link" class="link-box" type="text" readonly value="<%= kit_link(@kit) %>" data-copy-target="source">
      <button type="button" class="btn btn--secondary" data-action="copy#copy" data-copy-target="button" hidden>
        <span data-copy-target="label">Copy the link</span>
      </button>
    </section>

    <section class="stack" aria-labelledby="delete-title">
      <h2 id="delete-title" class="m-0">Delete everything</h2>
      <p class="m-0">Deletes your photos, answers and links now.</p>
      <%= render "components/button", label: "Delete everything", href: delete_kit_path(@kit), variant: :danger, icon: :trash %>
    </section>
  <% end %>
</div>
