<%# One preview. Broadcast replaces it by dom_id(render) as it moves from pending to done or failed. %>
<% kind_words = { "classic" => "classic look", "easy" => "easy version", "tweak" => "easy version", "transfer" => "signature look", "step" => "step" }.fetch(render.kind, "look") %>
<div id="<%= render.persisted? ? dom_id(render) : "missing_#{render.kind}" %>" class="render render--<%= render.status %>">
  <% if render.done? && render.result.attached? %>
    <%= render_image(render, alt: "Your photo with the #{kind_words}. A preview, not a promise.") %>
  <% elsif render.failed? %>
    <div class="render__message" role="status">
      <p><%= render_failure_message(render) %></p>
      <% if RendersHelper::TRY_AGAIN.include?(render.failure_reason) && render.persisted? %>
        <%= render(partial: "components/button", locals: { label: "Try again", url: try_again_kit_render_path(render.kit, render), variant: :secondary }) %>
      <% elsif render.failure_reason == "example" %>
        <%= render(partial: "components/button", locals: { label: "Start your own kit", href: start_path, variant: :secondary }) %>
      <% elsif render_failure_needs_photo?(render) %>
        <%= render(partial: "components/button", locals: { label: "Take it again", href: new_kit_photo_path(render.kit, kind: (render.transfer? ? "reference" : "today")), variant: :secondary }) %>
      <% end %>
    </div>
  <% else %>
    <div class="render__message" role="status">
      <span class="render__dot" aria-hidden="true"></span>
      <%# A preview already asked for is checked again by the page itself (refresh_controller.js) if live updates can't reach it. %>
      <p><%= render.running? ? "Putting the #{kind_words} on your photo." : "Getting your photo ready." %> This takes about half a minute.<% if render.persisted? %> If it takes longer, this page checks again by itself.<% end %></p>
    </div>
  <% end %>
</div>
