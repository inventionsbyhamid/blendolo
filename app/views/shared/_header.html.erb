<header class="top">
  <div class="wrap top__row">
    <%= link_to root_path, class: "brand", "aria-label": "Blendolo home" do %>
      <%= image_tag "mark.svg", alt: "", width: 40, height: 40 %>
      <span>Blendolo</span>
    <% end %>
    <% if content_for?(:header_nav) %>
      <%= yield :header_nav %>
    <% elsif !@kit&.persisted? && !signed_in? && !current_page?(pricing_path) %>
      <%# Signed out, away from a kit: Pricing in the bar. Signed in, it's in the account menu. %>
      <nav aria-label="Main"><ul class="nav"><li class="nav__keep"><%= link_to "Pricing", pricing_path %></li></ul></nav>
    <% end %>
    <% if @kit&.persisted? %>
      <%= render "kits/menu", kit: @kit %>
    <% elsif signed_in? %>
      <%= render "accounts/menu" %>
    <% end %>
  </div>
</header>
