<div class="page stack">
  <h1 class="m-0">Share with a helper</h1>
  <p class="lead m-0">A private link to <%= you_or_they(@kit, "your", "their") %> routine. It stops working after 30 days, or when you switch it off.</p>
  <% if params[:made].present? && (made = @shares.find { |share| share.token == params[:made] }) %>
    <div class="card stack" data-controller="copy">
      <label for="share-link"><strong>Your new link</strong></label>
      <input id="share-link" class="link-box" type="text" readonly value="<%= public_share_url(made.token) %>" data-copy-target="source">
      <button type="button" class="btn btn--secondary" data-action="copy#copy" data-copy-target="button" hidden><span data-copy-target="label">Copy the link</span></button>
    </div>
  <% end %>

  <h2 class="m-0">Who is it for?</h2>
  <ul class="tiles">
    <% { "helper" => "A helper", "family" => "Family", "therapist" => "An occupational therapist" }.each do |audience, label| %>
      <li><%= render "components/tile", label: label, hint: "Routine only", url: kit_shares_path(@kit), method: :post, params: { audience:, scope: "routine_only" } %></li>
    <% end %>
  </ul>

  <% if @shares.any? %>
    <h2 class="m-0">Links that work now</h2>
    <ul class="stack list-none p-0 m-0">
      <% @shares.each do |share| %>
        <li class="card stack">
          <p class="m-0"><strong><%= share.audience.humanize %></strong>, until <%= l share.expires_at.to_date, format: :long %></p>
          <%= render "components/button", label: "Switch this link off", url: kit_share_path(@kit, share.token), method: :delete, variant: :danger %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
