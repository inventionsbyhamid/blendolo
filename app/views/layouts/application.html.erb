<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><%= seo_title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#FFF8F0">
    <meta name="color-scheme" content="light">
    <meta name="application-name" content="Blendolo">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Blendolo">
    <meta name="mobile-web-app-capable" content="yes">
    <%# No hover prefetch: some kit pages start work, and private pages shouldn't load before a tap. %>
    <meta name="turbo-prefetch" content="false">
    <%= seo_tags %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <%= preload_link_tag "Nunito.woff2", as: "font", type: "font/woff2", crossorigin: "anonymous" %>
    <%= yield :head %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-hands="<%= hands_today %>" class="<%= content_for(:body_class) %>">
    <a class="skip" href="#main">Skip to content</a>
    <%= render "shared/header" %>

    <%# refresh: reloads the page while a preview is on its way, in case live updates can't reach it. %>
    <main id="main" data-controller="refresh">
      <% if notice.present? %><p class="flash" role="status"><%= notice %></p><% end %>
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
  </body>
</html>
