<%# The account page's billing sections: the Clinic plan with "Manage" (the payment provider's portal), and purchases. %>
<% purchases = BillingEvent.purchases.where(user:).limit(24).to_a %>
<% refunded = purchases.select { it.refund? || it.dispute? }.map(&:payment_id).compact %>
<% customer = user.billing_customer_id.present? %>
<% clinic = Billing::Plan.fetch(:clinic) %>

<section class="card stack" aria-labelledby="clinic-plan-title">
  <h2 id="clinic-plan-title" class="m-0">Clinic plan</h2>
  <% if user.clinic? %>
    <p class="m-0"><%= clinic_status_words(user) %></p>
    <%= render "components/button", label: "Your clients", href: clinic_path, variant: :primary %>
    <p class="m-0">Change your card, see receipts or cancel, at Dodo Payments.</p>
    <%= render "components/button", label: "Manage", url: billing_portal_path, variant: :secondary, form: { data: { turbo: false } } %>
  <% else %>
    <p class="m-0">For occupational therapists and care teams: a kit for each client and <%= clinic.credits %> credits a month.</p>
    <%= render "components/button", label: "See the Clinic plan", href: pricing_path(anchor: "clinic"), variant: :secondary %>
  <% end %>
</section>

<section class="stack" aria-labelledby="purchases-title">
  <h2 id="purchases-title" class="m-0">Purchases</h2>
  <% if purchases.any? %>
    <ul class="purchases">
      <% purchases.each do |event| %>
        <li>
          <span class="purchases__what"><%= purchase_words(event) %></span>
          <span class="purchases__when"><%= l event.created_at.to_date, format: :long %><% if event.pack_paid? && refunded.include?(event.payment_id) %>, paid back<% end %></span>
        </li>
      <% end %>
    </ul>
    <% if customer && !user.clinic? %>
      <p class="m-0">Receipts are at Dodo Payments, who took the payment.</p>
      <%= render "components/button", label: "Receipts", url: billing_portal_path, variant: :secondary, form: { data: { turbo: false } } %>
    <% end %>
  <% else %>
    <p class="m-0">No purchases yet.</p>
  <% end %>
</section>
