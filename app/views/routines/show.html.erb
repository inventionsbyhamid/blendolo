<div class="page stack">
  <h1 class="m-0">Your routine</h1>
  <p class="lead m-0">Detailed steps first, while hands are fresh. Tidy up last.</p>
  <ol class="linklist">
    <% @steps.each.with_index(1) do |step, number| %>
      <li><%= link_to step_kit_routine_path(@kit, number) do %>Step <%= number %>: <%= step.name %><small><%= step.product_type %><%= ", optional" if step.optional? %></small><% end %></li>
    <% end %>
  </ol>
  <%= render "components/button", label: "Start with step 1", href: step_kit_routine_path(@kit, 1), variant: :primary, icon: :next %>
  <div class="button-row button-row--2">
    <%= render "components/button", label: "Print the cards", href: print_kit_routine_path(@kit), variant: :secondary %>
    <%= render "components/button", label: "Shopping list", href: kit_shopping_path(@kit), variant: :secondary %>
  </div>
</div>
