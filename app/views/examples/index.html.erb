<% seo title: "Try with an example person", description: "See Blendolo with an example person: their hands, their looks and the easy version, with no photo of you." %>
<div class="page stack">
  <header class="stack">
    <h1 class="m-0">Try with an example person</h1>
    <p class="lead m-0">Their answers and photos are ready, so you can see everything without a photo of you.</p>
    <%= render "components/honest_label", text: "AI generated example people" %>
  </header>
  <ul class="tiles">
    <% @people.each do |person| %>
      <li><%= render "components/tile", label: person.name, hint: person.blurb, url: start_example_path(person.key), method: :post %></li>
    <% end %>
  </ul>
</div>
