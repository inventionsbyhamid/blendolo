# Runtime environment for production. Development and tests need none of these: without GOOGLE_CLIENT_ID,
# development offers "Sign in as a test person (local only)", and without DODO_API_KEY a local test checkout.
# Production never has either.
# Production refuses to boot while a required variable is blank (lib/required_env.rb).
# Never commit real values: copy this file to .env, which git ignores.

# Signs sessions and cookies. Set one of the two.
SECRET_KEY_BASE=
RAILS_MASTER_KEY=

# Postgres: the server's host name and the password of the "blendolo" role.
# The app uses four databases on it: primary, cache, queue and cable.
DB_HOST=
BLENDOLO_DATABASE_PASSWORD=

# Cloudflare R2, where uploaded photos are stored.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Which appearance provider to use: "fake" (recorded responses, no cost) or "youcam" (live).
APPEARANCE_PROVIDER=fake

# Required only when APPEARANCE_PROVIDER=youcam.
# Comma-separated API keys.
YOUCAM_API_KEYS=
# Most units the app may spend in one day.
YOUCAM_DAILY_UNIT_CAP=60
# No live calls when the unit balance would drop below this.
YOUCAM_UNIT_FLOOR=150
# Optional: verifies webhook callbacks.
YOUCAM_WEBHOOK_SECRET=

# Who people sign in with: "google" (the default, and the only one so far).
AUTH_PROVIDER=google
# Required on the web app when AUTH_PROVIDER=google (the worker boots without): a Google Cloud OAuth client (Web), with the redirect URI
# https://blendolo.dijmo.com/auth/google_oauth2/callback and the basic scopes (email, profile).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payments: Dodo Payments, the merchant of record (Billing::Dodo). Without these, pricing still shows and buying says
# payments aren't working. script/billing/dodo_setup.rb creates the products and the webhook and fills in the rest.
# test_mode (test cards) unless this says live_mode.
DODO_ENVIRONMENT=test_mode
DODO_API_KEY=
# Signs the webhooks Dodo sends to https://<your host>/webhooks/dodo.
DODO_WEBHOOK_SECRET=
# The product id of each paid plan in config/blendolo/plans.yml.
DODO_PRODUCT_LOOK_PACK=
DODO_PRODUCT_CLINIC=

# What this container runs: "web" (the site) or "jobs" (the background worker).
BLENDOLO_PROCESS=web

# Optional: "off" runs the hands-free capture checks on the page instead of in a Web Worker (slower pages; a switch
# for a browser that runs the worker badly).
CAPTURE_WORKER=on

# Optional: user name and password for the background jobs page at /jobs. Without both, it stays locked.
MISSION_CONTROL_USER=
MISSION_CONTROL_PASSWORD=
