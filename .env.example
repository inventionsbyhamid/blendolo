# Runtime environment for production. Development and tests need none of these.
# Production refuses to boot while a required variable is blank (lib/required_env.rb).
# Never commit real values: copy this file to .env, which git ignores.

# Signs sessions and cookies. Set one of the two.
SECRET_KEY_BASE=
RAILS_MASTER_KEY=

# Postgres: the server's host name and the password of the "blendolo" role.
# The app uses four databases on it: primary, cache, queue and cable.
DB_HOST=
BLENDOLO_DATABASE_PASSWORD=

# Cloudflare R2, where uploaded photos are stored.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Which appearance provider to use: "fake" (recorded responses, no cost) or "youcam" (live).
APPEARANCE_PROVIDER=fake

# Required only when APPEARANCE_PROVIDER=youcam.
# Comma-separated API keys.
YOUCAM_API_KEYS=
# Most units the app may spend in one day.
YOUCAM_DAILY_UNIT_CAP=60
# No live calls when the unit balance would drop below this.
YOUCAM_UNIT_FLOOR=150
# Optional: verifies webhook callbacks.
YOUCAM_WEBHOOK_SECRET=

# What this container runs: "web" (the site) or "jobs" (the background worker).
BLENDOLO_PROCESS=web

# Optional: user name and password for the background jobs page at /jobs. Without both, it stays locked.
MISSION_CONTROL_USER=
MISSION_CONTROL_PASSWORD=
