#!/bin/bash -e

# The worker runs this same image with BLENDOLO_PROCESS=jobs: Solid Queue instead of the web server. Only the image's
# default command is swapped, so a one-off command (a console, a rake task) runs as given even with the jobs env.
if [ "${BLENDOLO_PROCESS}" == "jobs" ] && [ "$*" == "./bin/thrust ./bin/rails server" ]; then
  set -- ./bin/jobs
fi

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
fi

exec "${@}"
